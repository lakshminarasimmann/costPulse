# FreightTiger Smart Shipping Cost Assistant Configuration

# LLM Backend: "rule_based" (default, free, deterministic), "groq", or "ollama"
LLM_BACKEND=rule_based

# Groq Cloud API (Optional - free tier available at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Ollama Local (Optional - requires ollama run llama3.1)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
